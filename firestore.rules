rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /rsvps/{rsvpId} {
      allow read, list: if true;
      allow create, update: if request.resource.data.headcount is number 
                            && request.resource.data.headcount > 0;
      allow delete: if true;
    }

    match /testimonies/{testimonyId} {
      allow read, list: if true;
      allow create, update: if request.resource.data.message is string 
                            && request.resource.data.message.size() <= 1000;
      allow delete: if true;
    }
  }
}
